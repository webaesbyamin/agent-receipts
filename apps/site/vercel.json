{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@agent-receipts/site",
  "redirects": [
    { "source": "/receipts/:path*", "destination": "https://demo.receipts.webaes.com/receipts/:path*", "permanent": true },
    { "source": "/agents/:path*", "destination": "https://demo.receipts.webaes.com/agents/:path*", "permanent": true },
    { "source": "/chains/:path*", "destination": "https://demo.receipts.webaes.com/chains/:path*", "permanent": true },
    { "source": "/verify/:path*", "destination": "https://demo.receipts.webaes.com/verify/:path*", "permanent": true },
    { "source": "/walkthrough/:path*", "destination": "https://demo.receipts.webaes.com/walkthrough/:path*", "permanent": true },
    { "source": "/memory/:path*", "destination": "https://demo.receipts.webaes.com/memory/:path*", "permanent": true },
    { "source": "/invoices/:path*", "destination": "https://demo.receipts.webaes.com/invoices/:path*", "permanent": true },
    { "source": "/settings/:path*", "destination": "https://demo.receipts.webaes.com/settings/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
