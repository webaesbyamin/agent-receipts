{
  "name": "@agent-receipts/site",
  "version": "0.1.0",
  "private": true,
  "description": "receipts.webaes.com: Magic Folder and Agent Receipts, explained and installable",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "node scripts/generate.mjs && next dev -p 3275",
    "build": "node scripts/build.mjs",
    "test": "node scripts/check-guide.mjs && node --test \"test/*.test.mjs\"",
    "test:browser": "playwright test",
    "typecheck": "node scripts/generate.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@agent-receipts/crypto": "workspace:*",
    "@agent-receipts/magic-folder": "workspace:*",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "linkedom": "^0.18.12",
    "typescript": "^5.4.0"
  }
}
